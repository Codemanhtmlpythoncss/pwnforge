{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "difficulty",
    "category",
    "lessons"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "orientation",
        "beginner",
        "easy",
        "intermediate",
        "hard",
        "advanced",
        "expert",
        "mastery"
      ]
    },
    "category": {
      "type": "string"
    },
    "lessons": {
      "type": "array",
      "minItems": 1
    },
    "assessment": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}