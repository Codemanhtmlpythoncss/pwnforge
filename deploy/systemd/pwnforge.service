# Pwnforge systemd service unit.
#
# Install:
#   sudo cp deploy/systemd/pwnforge.service /etc/systemd/system/
#   edit User=, WorkingDirectory= and Environment= below to match your install,
#   then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now pwnforge
#
# Restarting this service does NOT stop running VMs — those are managed by
# libvirtd, which is a separate service. On start, Pwnforge reconciles its
# database with the hypervisor's actual state.

[Unit]
Description=Pwnforge cybersecurity training platform
After=network-online.target libvirtd.service
Wants=network-online.target
# libvirtd is only required for real virtualisation:
Wants=libvirtd.service

[Service]
Type=simple
# Run as a dedicated non-root user that is a member of the 'libvirt' and 'kvm'
# groups. NEVER run Pwnforge as root.
User=pwnforge
Group=pwnforge
SupplementaryGroups=libvirt kvm
WorkingDirectory=/opt/pwnforge
Environment=PWNFORGE_DATA_DIR=/var/lib/pwnforge
# Bind address/port come from the DB settings (server.port / server.lan_access).
ExecStart=/opt/pwnforge/.venv/bin/pwnforge serve
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/pwnforge

[Install]
WantedBy=multi-user.target
